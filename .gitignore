# Coverage testing files.
.coverage
/htmlcov

# Environment configuration files. These hold the real SECRET_KEY and any
# database or SMTP credentials, so every variant is excluded and only the
# documented example is tracked.
.env
.env.*
!.env.example

# Local application data (SQLite database, uploaded media) from the Docker
# stack's bind mount.
/babybuddy-data

# Virtual environment files (pipenv may use this convention).
.venv

# IDE configuration files.
/.idea

# Node development dependencies.
/node_modules

# Python files.
*.pyc

# App static file directories.
/*/static

# Django media root directory.
/media

# Pipfile.lock.
# Committing this file makes it difficult to support multiple Python versions as
# requirements can different between versions, but the Pipfile only supports
# locking to one version.
Pipfile.lock

# Documentation
/site

# macOS files
.DS_Store

# Devenv
.devenv*
devenv.local.nix

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

.vscode