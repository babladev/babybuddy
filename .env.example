# Baby Buddy configuration for the Docker stack.
# Copy to .env and edit. Never commit .env - it is listed in .gitignore.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=

# Hostname(s) Baby Buddy will answer for, comma separated. Never leave this as
# "*": an unrestricted value allows Host header attacks, which can poison
# password reset links. 127.0.0.1 is required for the container healthcheck.
ALLOWED_HOSTS=babybuddy.example.com,127.0.0.1

# Address Caddy serves. Use a bare hostname for an automatic Let's Encrypt
# certificate, or see docker/Caddyfile for a LAN-only local CA certificate.
SITE_ADDRESS=babybuddy.example.com

# Email address Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# Origins allowed to submit forms. Include the scheme. Required when running
# behind a proxy, otherwise logins fail with a CSRF error.
CSRF_TRUSTED_ORIGINS=https://babybuddy.example.com

# ---------------------------------------------------------------------------
# First run
# ---------------------------------------------------------------------------

# The initial superuser, created only when no superuser exists yet. If the
# password is left blank a random one is generated and written to the container
# log once (`docker compose logs babybuddy`). Change it after first login.
BABYBUDDY_ADMIN_USERNAME=admin
BABYBUDDY_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Transport security
# ---------------------------------------------------------------------------

# Trust the X-Forwarded-Proto header. Safe here because Caddy always overwrites
# it, so a client cannot spoof it. Do not enable this if the app is reachable
# without going through the proxy.
SECURE_PROXY_SSL_HEADER=True

# Restrict cookies to HTTPS. Both should be True once TLS is working.
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HTTP Strict Transport Security, in seconds. Start small (e.g. 300) to confirm
# TLS works, then raise to 31536000 (one year). Browsers cache this, so a
# premature large value locks you out of plain HTTP for that duration.
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Caddy already redirects HTTP to HTTPS, so Django's own redirect is redundant.
# Enable it only if you replace Caddy with a proxy that does not redirect.
# SECURE_SSL_REDIRECT=True

# How long a session stays valid, in seconds. Default is Django's two weeks.
SESSION_COOKIE_AGE=604800

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

# Rate limits for the REST API. Anonymous requests are limited separately from
# authenticated ones. Set either to an empty value to disable throttling.
API_THROTTLE_RATE_ANON=20/min
API_THROTTLE_RATE_USER=1000/hour

# Cross-origin API access. Leave unset unless another site needs to call the
# API from a browser.
# CORS_ALLOWED_ORIGINS=https://other.example.com

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

# Without an SMTP host, Django writes password reset emails - including the
# reset token - to the container log, where anyone with log access can use them
# to take over an account. Configure SMTP, or accept that password resets are
# only usable by someone who can read `docker compose logs`.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=babybuddy@example.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_FROM=babybuddy@example.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SQLite in the /data volume by default, which is plenty for a household.
# For the optional postgres profile, uncomment both lines and start with:
#   docker compose --profile postgres up -d
# POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgres://babybuddy:change-me@db:5432/babybuddy

# ---------------------------------------------------------------------------
# Optional features
# ---------------------------------------------------------------------------

# Allow photo and file uploads.
ALLOW_UPLOADS=True

# Serve uploaded media through a login-required view instead of exposing the
# media directory publicly. Leave enabled unless a proxy serves /media itself.
SERVE_MEDIA_AUTHENTICATED=True

# Home Assistant ingress support. This makes the app trust the X-Ingress-Path
# and X-Hass-Source request headers, so leave it off unless you run under
# Home Assistant.
ENABLE_HOME_ASSISTANT_SUPPORT=False

# Authenticate users from a proxy-supplied header. Only enable with a proxy that
# strips this header from client requests.
REVERSE_PROXY_AUTH=False

# Never enable in production - DEBUG exposes settings and stack traces.
DEBUG=False

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Which client addresses gunicorn accepts X-Forwarded-* headers from. "*" is
# acceptable here because the container is only reachable from the compose
# network. Narrow it if you publish the app port directly.
GUNICORN_FORWARDED_ALLOW_IPS=*
